#!/bin/bash
# ZFS pool/dataset metrics for node_exporter's textfile collector (root cron, every minute).
# One script for tinynas (docker node-exporter) and mementos (apt prometheus-node-exporter), covering every pool.
# homepage and the zfs_rules.yml recording rule query these metric names, so keep them stable.
set -uo pipefail

# whichever textfile directory this host's node_exporter reads
for DIR in /var/lib/node_exporter/textfile_collector /var/lib/prometheus/node-exporter ""; do
  [ -d "$DIR" ] && break
done
[ -n "$DIR" ] || { echo "zfs_metrics: no node_exporter textfile directory" >&2; exit 1; }
OUT=$DIR/zfs.prom
TMP=$(mktemp "$DIR/.zfs.prom.XXXXXX") || exit 1
trap 'rm -f "$TMP"' EXIT
pools=$(zpool list -H -o name)

# logical I/O per pool since import: the sum of its datasets' objset kstats
declare -A rops wops rbytes wbytes
for pool in $pools; do
  read -r r w nr nw < <(cat /proc/spl/kstat/zfs/"$pool"/objset-* 2>/dev/null | awk '
    $1 == "reads" {r += $3} $1 == "writes" {w += $3} $1 == "nread" {nr += $3} $1 == "nwritten" {nw += $3}
    END {printf "%.0f %.0f %.0f %.0f\n", r, w, nr, nw}')
  rops[$pool]=$r; wops[$pool]=$w; rbytes[$pool]=$nr; wbytes[$pool]=$nw
done

{
  echo "# HELP node_zfs_zpool_allocated_bytes ZFS pool allocated space in bytes (physical disk usage)."
  echo "# TYPE node_zfs_zpool_allocated_bytes gauge"
  zpool list -Hp -o name,alloc | awk '{printf "node_zfs_zpool_allocated_bytes{zpool=\"%s\"} %s\n", $1, $2}'

  echo "# HELP node_zfs_zpool_free_bytes ZFS pool free space in bytes."
  echo "# TYPE node_zfs_zpool_free_bytes gauge"
  zpool list -Hp -o name,free | awk '{printf "node_zfs_zpool_free_bytes{zpool=\"%s\"} %s\n", $1, $2}'

  echo "# HELP node_zfs_zpool_dataset_used_bytes ZFS dataset used space in bytes (logical data usage)."
  echo "# TYPE node_zfs_zpool_dataset_used_bytes gauge"
  zfs list -Hp -o name,used | awk '{split($1, p, "/"); printf "node_zfs_zpool_dataset_used_bytes{dataset=\"%s\",zpool=\"%s\"} %s\n", $1, p[1], $2}'

  echo "# HELP node_zfs_zpool_dataset_available_bytes ZFS dataset available space in bytes."
  echo "# TYPE node_zfs_zpool_dataset_available_bytes gauge"
  zfs list -Hp -o name,avail | awk '{split($1, p, "/"); printf "node_zfs_zpool_dataset_available_bytes{dataset=\"%s\",zpool=\"%s\"} %s\n", $1, p[1], $2}'

  echo "# HELP node_zfs_zpool_health_status ZFS pool health status (0=OFFLINE/FAULTED, 0.5=DEGRADED, 1=ONLINE)."
  echo "# TYPE node_zfs_zpool_health_status gauge"
  zpool list -H -o name,health | awk '{v = ($2 == "ONLINE") ? 1 : ($2 == "DEGRADED") ? 0.5 : 0; printf "node_zfs_zpool_health_status{zpool=\"%s\",health=\"%s\"} %s\n", $1, $2, v}'

  echo "# HELP node_zfs_zpool_errors_total ZFS read+write+checksum errors summed over the pool, its vdevs and disks."
  echo "# TYPE node_zfs_zpool_errors_total counter"
  for pool in $pools; do
    zpool status -p "$pool" | awk -v p="$pool" '
      /^config:/ {c = 1; next}
      /^errors:/ {c = 0}
      c && NF >= 5 && $3 ~ /^[0-9]+$/ && $4 ~ /^[0-9]+$/ && $5 ~ /^[0-9]+$/ {s += $3 + $4 + $5}
      END {printf "node_zfs_zpool_errors_total{zpool=\"%s\"} %d\n", p, s}'
  done

  echo "# HELP node_zfs_zpool_last_scrub_timestamp_seconds When the last completed scrub finished (0 = never)."
  echo "# TYPE node_zfs_zpool_last_scrub_timestamp_seconds gauge"
  for pool in $pools; do
    when=$(zpool status "$pool" | sed -n 's/^ *scan: scrub repaired .* on \(.*\)$/\1/p')
    ts=0
    [ -n "$when" ] && ts=$(date -d "$when" +%s 2>/dev/null || echo 0)
    echo "node_zfs_zpool_last_scrub_timestamp_seconds{zpool=\"$pool\"} $ts"
  done

  echo "# HELP node_zfs_zpool_read_ops_total Read operations on the pool's datasets since import."
  echo "# TYPE node_zfs_zpool_read_ops_total counter"
  for pool in $pools; do echo "node_zfs_zpool_read_ops_total{zpool=\"$pool\"} ${rops[$pool]}"; done
  echo "# HELP node_zfs_zpool_write_ops_total Write operations on the pool's datasets since import."
  echo "# TYPE node_zfs_zpool_write_ops_total counter"
  for pool in $pools; do echo "node_zfs_zpool_write_ops_total{zpool=\"$pool\"} ${wops[$pool]}"; done
  echo "# HELP node_zfs_zpool_read_bytes_total Bytes read from the pool's datasets since import."
  echo "# TYPE node_zfs_zpool_read_bytes_total counter"
  for pool in $pools; do echo "node_zfs_zpool_read_bytes_total{zpool=\"$pool\"} ${rbytes[$pool]}"; done
  echo "# HELP node_zfs_zpool_written_bytes_total Bytes written to the pool's datasets since import."
  echo "# TYPE node_zfs_zpool_written_bytes_total counter"
  for pool in $pools; do echo "node_zfs_zpool_written_bytes_total{zpool=\"$pool\"} ${wbytes[$pool]}"; done
} > "$TMP"

chmod 644 "$TMP"
mv "$TMP" "$OUT"
