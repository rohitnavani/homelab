#!/bin/bash

# ZFS Daily Snapshot Script
# Creates snapshots with a daily-YYYYMMDD naming convention

# Datasets to snapshot (all under homePool/, excluding homePool/download)
SNAPSHOT_TARGETS=$(zfs list -H -o name | grep -v 'homePool/download' | grep /)

# Snapshot suffix (e.g., daily-20250702)
SNAPSHOT_SUFFIX="$(date +%s)"

echo "$(date '+%Y-%m-%d %H:%M:%S') - Starting daily snapshots for: $SNAPSHOT_SUFFIX"

for dataset in $SNAPSHOT_TARGETS; do
    echo "$(date '+%Y-%m-%d %H:%M:%S') - Taking snapshot: ${dataset}@${SNAPSHOT_SUFFIX}"
    sudo zfs snapshot "${dataset}@${SNAPSHOT_SUFFIX}"
    if [ $? -ne 0 ]; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') - ERROR: Failed to create snapshot for $dataset" >&2
    fi
done

echo "$(date '+%Y-%m-%d %H:%M:%S') - Daily snapshots finished."
