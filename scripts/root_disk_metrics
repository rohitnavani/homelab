#!/bin/bash
# Root filesystem usage for homepage's "Root Disk Used" widget, which queries custom_root_disk_used_gb
# in Prometheus. Written as a node_exporter textfile (root_disk.prom); the old custom_data txt target is gone.

# Get used and total blocks for the root filesystem
# Using df -P to ensure POSIX output for consistent parsing
read -r total_blocks used_blocks < <(df -P / | awk 'NR==2 {print $2, $3}')
block_size_bytes=1024 # df -k reports in 1KB blocks

# Calculate total and used bytes
total_bytes=$((total_blocks * block_size_bytes))
used_bytes=$((used_blocks * block_size_bytes))

# Convert to Gigabytes (float) for display, rounding to 2 decimal places
total_gb=$(echo "scale=2; $total_bytes / (1024*1024*1024)" | bc)
used_gb=$(echo "scale=2; $used_bytes / (1024*1024*1024)" | bc)
free_gb=$(echo "scale=2; ($total_bytes - $used_bytes) / (1024*1024*1024)" | bc)

# Write the metrics atomically where node_exporter reads them
METRICS_DIR="/var/lib/node_exporter/textfile_collector"
TEMP_FILE=$(mktemp "$METRICS_DIR/.root_disk.prom.XXXXXX") || exit 1
cat > "$TEMP_FILE" <<EOF
# HELP custom_root_disk_total_gb Total size of the root filesystem in Gigabytes.
# TYPE custom_root_disk_total_gb gauge
custom_root_disk_total_gb $total_gb
# HELP custom_root_disk_used_gb Used space on the root filesystem in Gigabytes.
# TYPE custom_root_disk_used_gb gauge
custom_root_disk_used_gb $used_gb
# HELP custom_root_disk_free_gb Free space on the root filesystem in Gigabytes.
# TYPE custom_root_disk_free_gb gauge
custom_root_disk_free_gb $free_gb
EOF
chmod 644 "$TEMP_FILE"
mv "$TEMP_FILE" "$METRICS_DIR/root_disk.prom"
