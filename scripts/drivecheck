#!/usr/bin/python3 -I
"""drivecheck - daily health check of every SATA, SAS and NVMe drive on a host (v2).

Reads each drive with `smartctl -x --json=o -n standby`, one at a time, prints a report on stdout (cron and the
roaming timer append it to /var/log/drive_logs/drive_check_YYYY-MM-DD.log), writes Prometheus metrics for
node_exporter's textfile collector, and emails on alert when a local mailer exists.

History
  2026-10-06  v1: bash refactor of the original TinyNAS-only check (smartctl --scan, ATA/SAS/NVMe parsing,
              day-over-day MARK lines, textfile output, email on alert). 2026-10-10: NVMe self-test results.
  2026-10-16  v2: Python rewrite on smartctl's JSON, after a full audit of the lab's 70 drives found what v1 missed:
              - day-over-day state in /var/lib/drivecheck/state.json; the first sight of a drive is a baseline, never
                an alert (v1 alerted "0 -> N" on every counter the first day)
              - new signals: SSD wear and reported-uncorrectable reads (ATA 187); NVMe critical warning, unsafe
                shutdowns, over-temperature minutes and thermal throttling; SAS ECC-delayed and reread counters,
                background-scan recovered reads and PHY link errors; the ATA error log; normalized attribute values
                near their threshold; each drive's temperature limit; the last LONG self-test
              - an interrupted or aborted self-test (reboot, suspend) is no longer a failure
              - kernel I/O errors are counted over the last 24 h across reboots, not since boot
              - network LUNs (iSCSI) are skipped, as drive-selftest already did

Environment
  DRIVECHECK_LOG_DIR       log directory (default /pool/drive_logs if it exists, else /var/log/drive_logs)
  DRIVECHECK_TEXTFILE_DIR  where drivecheck.prom goes (default /var/lib/node_exporter/textfile_collector if present)
  DRIVECHECK_EMAIL         alert address (default rohitnavani@gmail.com)
  DRIVECHECK_NO_MAIL=1     never send email
  DRIVECHECK_STATE         state file (default /var/lib/drivecheck/state.json)
  DRIVECHECK_PAUSE         seconds between drives (default 1): fan controllers on some hosts poll the same drives

Offline test
  drivecheck --fixtures DIR --out OUTDIR [--host NAME]
  reads DIR/smart-*.json (saved `smartctl -x --json=o` output) instead of the drives and writes drivecheck.prom and
  state.json only under OUTDIR: no journal, no mail, nothing else touched.
"""
import argparse
import datetime
import glob
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time

VERSION = "2.0 (2026-10-16)"

# v1 always emitted these five ATA attributes under fixed names; keep them so the series continue
V1_ATA = {5: "Reallocated_Sector_Ct", 196: "Reallocated_Event_Count", 197: "Current_Pending_Sector",
          198: "Offline_Uncorrectable", 199: "UDMA_CRC_Error_Count"}
# added in v2, emitted when the drive has them, under the drive's own attribute names
NEW_ATA = (10, 183, 184, 187, 188)
# a rise in any of these since the last run is an alert
RISING_ATA = (5, 10, 187, 196, 197, 198, 199)
KERNEL_IO = re.compile(r"i/o error|blk_update_request|buffer i/o", re.I)
BMS_LINE = re.compile(r"^\s*(\d+)\s+(\d+):(\d+)\s+([0-9a-fA-F]+)\s+\[(\w+),(\w+),(\w+)\]\s+(.*)$")
BMS_RECENT_HOURS = 168

HELP = {
    "drivecheck_health_ok": "1 if the drive's SMART overall health passed",
    "drivecheck_temperature_celsius": "Current drive temperature",
    "drivecheck_power_on_hours": "Drive power-on hours",
    "drivecheck_selftest_passed": "0 if the newest SMART self-test failed (interrupted or aborted counts as 1)",
    "drivecheck_ata_attr_raw": "Raw value of selected ATA SMART attributes",
    "drivecheck_sas_grown_defects": "SAS grown defect list length",
    "drivecheck_sas_uncorrected_errors": "SAS total uncorrected read+write+verify errors",
    "drivecheck_sas_nonmedium_errors": "SAS non-medium error count",
    "drivecheck_nvme_available_spare_percent": "NVMe available spare",
    "drivecheck_nvme_percentage_used": "NVMe percentage used (endurance)",
    "drivecheck_nvme_media_errors": "NVMe media and data integrity errors",
    "drivecheck_nvme_error_log_entries": "NVMe error information log entries (lifetime)",
    "drivecheck_drive_info": "Drive identity (value always 1)",
    "drivecheck_temperature_limit_celsius": "Drive temperature limit: SATA spec max, SAS drive trip, NVMe warning",
    "drivecheck_temperature_margin_celsius": "Temperature limit minus current temperature",
    "drivecheck_standby": "1 if the drive was asleep and left unread",
    "drivecheck_ata_attr_margin": "ATA normalized value minus threshold, for attributes with a threshold",
    "drivecheck_ata_error_log_count": "ATA SMART error log count",
    "drivecheck_ssd_percentage_used": "SSD endurance used (ATA device statistics or vendor attribute, SAS, NVMe)",
    "drivecheck_selftest_last_long_ok": "Newest long/extended self-test: 1 ok, 0 failed, -1 interrupted or aborted",
    "drivecheck_selftest_last_long_age_hours": "Power-on hours since the newest long/extended self-test",
    "drivecheck_sas_ecc_delayed_total": "SAS errors corrected with delay, by operation",
    "drivecheck_sas_rereads_rewrites_total": "SAS errors corrected by rereads or rewrites, by operation",
    "drivecheck_sas_bms_entries": "Entries in the SAS background media scan results log",
    "drivecheck_sas_bms_recent_entries": "Background-scan entries in the last 168 power-on hours",
    "drivecheck_sas_phy_errors": "SAS PHY error counters as the drive sees its link, by port and kind",
    "drivecheck_nvme_critical_warning": "NVMe critical warning bit field",
    "drivecheck_nvme_unsafe_shutdowns": "NVMe unsafe shutdowns (lifetime)",
    "drivecheck_nvme_power_cycles": "NVMe power cycles (lifetime)",
    "drivecheck_nvme_warning_temp_minutes": "NVMe minutes above the warning temperature (lifetime)",
    "drivecheck_nvme_critical_temp_minutes": "NVMe minutes above the critical temperature (lifetime)",
    "drivecheck_nvme_thermal_throttle_events": "NVMe thermal management transitions, by level (lifetime)",
    "drivecheck_kernel_io_errors": "Kernel I/O error lines in the last 24 h, across reboots",
    "drivecheck_alerts_total": "Number of drive alerts at last run.",
    "drivecheck_last_run_timestamp_seconds": "Unix time of the last drivecheck run",
}


def esc(v):
    return str(v).replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")


class Metrics:
    def __init__(self):
        self.fam = {}

    def add(self, name, labels, value):
        if value is None:
            return
        self.fam.setdefault(name, []).append((labels, value))

    def render(self):
        out = []
        for name, samples in self.fam.items():
            out.append(f"# HELP {name} {HELP.get(name, name)}")
            out.append(f"# TYPE {name} gauge")
            for labels, value in samples:
                lab = ",".join(f'{k}="{esc(v)}"' for k, v in labels.items())
                val = int(value) if isinstance(value, bool) or float(value).is_integer() else value
                out.append(f"{name}{{{lab}}} {val}")
        return "\n".join(out) + "\n"


def ival(x, default=None):
    try:
        return int(str(x).replace(",", ""))
    except (TypeError, ValueError):
        try:
            return int(float(str(x)))
        except (TypeError, ValueError):
            return default


# ------------------------------------------------------------------ self-tests
def selftests(j, proto):
    """Newest first: dicts with long (bool), kind (ok|fail|interrupted|running|other), status, hours."""
    tests = []
    if proto == "ATA":
        log = j.get("ata_smart_self_test_log") or {}
        tab = (log.get("extended") or log.get("standard") or {}).get("table") or []
        for t in tab:
            st = t.get("status") or {}
            code = (ival(st.get("value"), 0) >> 4) & 0xF
            kind = ("ok" if code == 0 else "interrupted" if code in (1, 2) else "fail" if 3 <= code <= 8
                    else "running" if code == 15 else "other")
            tests.append({"long": "extended" in (t.get("type") or {}).get("string", "").lower(), "kind": kind,
                          "status": st.get("string", "?"), "hours": t.get("lifetime_hours")})
    elif proto == "SCSI":
        keys = sorted((k for k in j if k.startswith("scsi_self_test_")), key=lambda k: int(k.rsplit("_", 1)[1]))
        for k in keys:
            t = j[k]
            code = ival((t.get("result") or {}).get("value"), 0)
            kind = ("ok" if code == 0 else "interrupted" if code in (1, 2) else "fail" if 3 <= code <= 7
                    else "running" if code == 15 else "other")
            tests.append({"long": "long" in (t.get("code") or {}).get("string", "").lower(), "kind": kind,
                          "status": (t.get("result") or {}).get("string", "?"),
                          "hours": (t.get("power_on_time") or {}).get("hours")})
    elif proto == "NVMe":
        for t in (j.get("nvme_self_test_log") or {}).get("table") or []:
            code = ival((t.get("self_test_result") or {}).get("value"), 15)
            if code == 15:
                continue
            kind = ("ok" if code == 0 else "fail" if code in (5, 6, 7) else "interrupted")
            tests.append({"long": "extended" in (t.get("self_test_code") or {}).get("string", "").lower(),
                          "kind": kind, "status": (t.get("self_test_result") or {}).get("string", "?"),
                          "hours": t.get("power_on_hours")})
    return tests


def test_age(proto, poh, hours):
    if poh is None or hours is None:
        return None
    if proto == "ATA" and (hours >= 65535 or poh >= 65535):   # 16-bit field: saturated or wrapped, undatable
        return None
    return poh - hours if poh >= hours else None


# ------------------------------------------------------------------ one drive
def analyse(j, dev, host, prev, now_iso):
    """Returns (report lines, metric samples as (name, labels, value), alerts, new state, skipped flag)."""
    lines, samples, alerts = [], [], []
    out = j.get("smartctl", {}).get("output") or []
    text = "\n".join(out)
    proto = (j.get("device") or {}).get("protocol")
    msgs = " ".join(m.get("string", "") for m in (j.get("smartctl", {}).get("messages") or []))
    if "STANDBY" in msgs.upper() or "in STANDBY mode" in text:
        lines.append(f"\n===DRIVE=== {dev} (standby)")
        lines.append("Asleep: left unread (smartctl -n standby)")
        samples.append(("drivecheck_standby", {"host": host, "device": dev}, 1))
        return lines, samples, alerts, None, True
    serial = (j.get("serial_number") or "").strip()
    if not serial or proto not in ("ATA", "SCSI", "NVMe"):
        lines.append(f"\nWARNING: no serial or unknown protocol for {dev}, skipping")
        return lines, samples, alerts, None, True
    rpm = j.get("rotation_rate")
    cls = {"ATA": "sata", "SCSI": "sas", "NVMe": "nvme"}[proto]
    kind = "nvme" if proto == "NVMe" else ("ssd" if rpm == 0 else "hdd")
    model = (j.get("scsi_model_name") if proto == "SCSI" else j.get("model_name")) or "?"
    model = " ".join(model.split())
    fw = j.get("firmware_version") or j.get("scsi_revision") or ""
    m = re.search(r"(?:User Capacity|Total NVM Capacity|Namespace 1 Size/Capacity|Namespace 1 Size):.*?\[([^\]]+)\]",
                  text)
    cap = m.group(1) if m else "?"
    base = {"host": host, "device": dev, "serial": serial}
    common = dict(base, **{"class": cls, "model": model})
    state = {"updated": now_iso}
    old = prev or {}

    def rising(key, cur, what):
        state[key] = cur
        p = old.get(key)
        if p is not None and cur is not None and cur > p:
            alerts.append(f"DRIVE {serial} ({dev} on {host}): {what} rose {p} -> {cur}")
            lines.append(f"ALERT: {what} {p} -> {cur}")

    lines.append(f"\n===DRIVE=== {dev} ({cls})")
    lines.append(f"Model: {model}, Serial: {serial}, Capacity: {cap}")
    lines.append(f"Firmware: {fw}, Kind: {kind}")
    samples.append(("drivecheck_drive_info", dict(base, **{"class": cls, "model": model, "firmware": fw,
                                                           "kind": kind}), 1))

    # health
    passed = (j.get("smart_status") or {}).get("passed")
    word = ("OK" if proto == "SCSI" else "PASSED") if passed else ("FAILED" if passed is False else "UNKNOWN")
    hok = 1 if passed else 0
    lines.append(f"Health: {word}")
    if not hok:
        alerts.append(f"DRIVE {serial} ({dev} on {host}): health {word}")
        lines.append(f"ALERT: health {word}")
    samples.append(("drivecheck_health_ok", common, hok))

    # temperature and its limit
    temp = (j.get("temperature") or {}).get("current")
    limit = None
    devstat = {}
    for p in (j.get("ata_device_statistics") or {}).get("pages") or []:
        for t in (p or {}).get("table") or []:
            if t and t.get("name"):
                devstat[t["name"]] = t.get("value")
    if proto == "ATA":
        limit = (devstat.get("Specified Maximum Operating Temperature") or (j.get("temperature") or {}).get("op_limit_max")
                 or ((j.get("ata_sct_status") or {}).get("temperature") or {}).get("op_limit_max"))
    elif proto == "SCSI":
        limit = (j.get("temperature") or {}).get("drive_trip")
    else:
        limit = (j.get("nvme_composite_temperature_threshold") or {}).get("warning")
        if not limit:
            m = re.search(r"Warning\s+Comp\. Temp\. Threshold:\s+(\d+)\s+Celsius", text)
            limit = int(m.group(1)) if m else None
    limit = limit if limit and limit > 0 else None
    poh = (j.get("power_on_time") or {}).get("hours")
    if temp is not None:
        lines.append(f"Temperature: {temp} C" + (f" (limit {limit} C)" if limit else ""))
        samples.append(("drivecheck_temperature_celsius", common, temp))
        if limit:
            samples.append(("drivecheck_temperature_limit_celsius", base, limit))
            samples.append(("drivecheck_temperature_margin_celsius", base, limit - temp))
    if poh is not None:
        lines.append(f"Power_On_Hours: {poh}")
        samples.append(("drivecheck_power_on_hours", common, poh))

    # self-tests
    tests = selftests(j, proto)
    if tests:
        t = tests[0]
        if t["kind"] == "fail":
            lines.append(f"Last self-test FAILED: {t['status']} at {t['hours']} h")
            alerts.append(f"DRIVE {serial} ({dev} on {host}): last self-test FAILED ({t['status']})")
        elif t["kind"] == "ok":
            lines.append("Last self-test passed")
        else:
            lines.append(f"Last self-test: {t['status']} ({t['kind']}, not a failure)")
        samples.append(("drivecheck_selftest_passed", base, 0 if t["kind"] == "fail" else 1))
        longs = [x for x in tests if x["long"] and x["kind"] != "running"]
        if longs:
            lt = longs[0]
            ok = {"ok": 1, "fail": 0}.get(lt["kind"], -1)
            age = test_age(proto, poh, lt["hours"])
            lines.append(f"Last long self-test: {lt['status']}" + (f", {age} h ago" if age is not None else
                                                                    ", age unknown"))
            samples.append(("drivecheck_selftest_last_long_ok", base, ok))
            if age is not None:
                samples.append(("drivecheck_selftest_last_long_age_hours", base, age))
        else:
            lines.append("No long self-test logged")
    else:
        lines.append("No self-test logged yet")

    # ------------------------------------------------ ATA (SATA, or SATA behind a SAS HBA)
    if proto == "ATA":
        attrs = {a["id"]: a for a in (j.get("ata_smart_attributes") or {}).get("table") or []}
        for aid in sorted(set(V1_ATA) | {i for i in NEW_ATA if i in attrs}):
            a = attrs.get(aid)
            name = V1_ATA.get(aid) or a["name"]
            raw = ival(((a or {}).get("raw") or {}).get("value"), 0)
            lines.append(f"MARK attr_{aid}={raw}    # {name}")
            samples.append(("drivecheck_ata_attr_raw", dict(base, id=str(aid), name=name), raw))
            if aid in RISING_ATA:
                rising(f"attr_{aid}", raw, f"{name} ({aid})")
        for aid in (197, 198):
            raw = ival(((attrs.get(aid) or {}).get("raw") or {}).get("value"), 0)
            if raw > 0 and kind == "hdd":
                alerts.append(f"DRIVE {serial} ({dev} on {host}): {V1_ATA[aid]} ({aid}) is {raw}")
                lines.append(f"ALERT: {V1_ATA[aid]} ({aid}) is {raw}")
        rows = []
        for a in sorted(attrs.values(), key=lambda a: a["id"]):
            th = a.get("thresh") or 0
            if th > 0:
                samples.append(("drivecheck_ata_attr_margin", dict(base, id=str(a["id"]), name=a["name"]),
                                a["value"] - th))
            if a["id"] in V1_ATA or a["id"] in NEW_ATA or (th > 0 and a["value"] - th <= 10):
                rows.append(f"{a['id']:>3} {a['name'][:24]:24} {a['value']:>3} {a['worst']:>3} {th:>3}  "
                            f"{(a.get('raw') or {}).get('string', '')}")
        if rows:
            lines.append("ID# ATTRIBUTE_NAME           VAL WST THR  RAW")
            lines.extend(rows)
        el = j.get("ata_smart_error_log") or {}
        cnt = ival((el.get("extended") or el.get("summary") or {}).get("count"), None)
        if cnt is not None:
            samples.append(("drivecheck_ata_error_log_count", base, cnt))
            if cnt:
                lines.append(f"ATA error log: {cnt} error(s) logged")
            state["ata_errlog"] = cnt
        if kind == "ssd":
            used = devstat.get("Percentage Used Endurance Indicator")
            if used is None and 202 in attrs and "lifetime" in attrs[202]["name"].lower():
                used = ival(attrs[202]["raw"]["value"])
            if used is None and 231 in attrs:
                used = 100 - attrs[231]["value"]
            if used is None and 169 in attrs and "remaining" in attrs[169]["name"].lower():
                used = 100 - attrs[169]["value"]
            if used is not None:
                lines.append(f"SSD wear: {used}% used")
                samples.append(("drivecheck_ssd_percentage_used", base, used))

    # ------------------------------------------------ SAS / SCSI
    elif proto == "SCSI":
        gdl = ival(j.get("scsi_grown_defect_list"), 0)
        ecl = j.get("scsi_error_counter_log") or {}
        unc = sum(ival((ecl.get(op) or {}).get("total_uncorrected_errors"), 0) for op in ("read", "write", "verify"))
        m = re.search(r"Non-medium error count:\s+(\d+)", text)
        nme = int(m.group(1)) if m else ival((j.get("scsi_nonmedium_error") or {}).get("count"), 0)
        lines.append(f"MARK grown_defects={gdl}")
        lines.append(f"MARK uncorrected={unc}")
        lines.append(f"MARK nonmedium={nme}")
        lines.append(f"Grown defect list: {gdl}    Uncorrected errors: {unc}    Non-medium errors: {nme}")
        samples.append(("drivecheck_sas_grown_defects", base, gdl))
        samples.append(("drivecheck_sas_uncorrected_errors", base, unc))
        samples.append(("drivecheck_sas_nonmedium_errors", base, nme))
        rising("grown_defects", gdl, "grown defect list")
        state["nonmedium"] = nme
        if unc > 0:
            alerts.append(f"DRIVE {serial} ({dev} on {host}): {unc} uncorrected errors")
            lines.append(f"ALERT: {unc} uncorrected errors")
        for op in ("read", "write", "verify"):
            row = ecl.get(op) or {}
            if row:
                samples.append(("drivecheck_sas_ecc_delayed_total", dict(base, op=op),
                                ival(row.get("errors_corrected_by_eccdelayed"), 0)))
                samples.append(("drivecheck_sas_rereads_rewrites_total", dict(base, op=op),
                                ival(row.get("errors_corrected_by_rereads_rewrites"), 0)))
        bms = []
        for l in out:
            mm = BMS_LINE.match(l)
            if mm:
                bms.append((int(mm.group(2)), mm.group(8).strip()))
        if "Background scan results log" in text or bms:
            recent = sum(1 for h, _ in bms if poh is not None and poh - h <= BMS_RECENT_HOURS)
            unrec = [s for _, s in bms if not s.lower().startswith("recovered") and "reassigned" not in s.lower()]
            lines.append(f"Background scan log: {len(bms)} entries, {recent} in the last {BMS_RECENT_HOURS} h"
                         + (f", {len(unrec)} not recovered" if unrec else ""))
            samples.append(("drivecheck_sas_bms_entries", base, len(bms)))
            samples.append(("drivecheck_sas_bms_recent_entries", base, recent))
        phy_lines = []
        for pk in sorted(k for k in j if re.match(r"scsi_sas_port_\d+$", k)):
            port = pk.rsplit("_", 1)[1]
            tot = {"invalid_dword": 0, "disparity": 0, "loss_sync": 0, "reset_problem": 0}
            seen = False
            for k, v in (j.get(pk) or {}).items():
                if k.startswith("phy_") and isinstance(v, dict):
                    seen = True
                    tot["invalid_dword"] += ival(v.get("invalid_dword_count"), 0)
                    tot["disparity"] += ival(v.get("running_disparity_error_count"), 0)
                    tot["loss_sync"] += ival(v.get("loss_of_dword_synchronization_count"), 0)
                    tot["reset_problem"] += ival(v.get("phy_reset_problem_count"), 0)
            if seen:
                for kk, vv in tot.items():
                    samples.append(("drivecheck_sas_phy_errors", dict(base, port=port, kind=kk), vv))
                if any(tot.values()):
                    phy_lines.append(f"port {port}: " + ", ".join(f"{k} {v}" for k, v in tot.items()))
        if phy_lines:
            lines.append("SAS link errors: " + "; ".join(phy_lines))
        if kind == "ssd":
            used = j.get("scsi_percentage_used_endurance_indicator")
            if used is not None:
                lines.append(f"SSD wear: {used}% used")
                samples.append(("drivecheck_ssd_percentage_used", base, used))

    # ------------------------------------------------ NVMe
    else:
        h = j.get("nvme_smart_health_information_log") or {}
        spare, used = h.get("available_spare"), h.get("percentage_used")
        media, elog = ival(h.get("media_errors"), 0), ival(h.get("num_err_log_entries"), 0)
        cw = ival(h.get("critical_warning"), 0)
        lines.append(f"MARK available_spare={spare if spare is not None else 100}")
        lines.append(f"MARK media_errors={media}")
        lines.append(f"MARK unsafe_shutdowns={ival(h.get('unsafe_shutdowns'), 0)}")
        lines.append(f"Available spare: {spare if spare is not None else '?'}%   Used: {used if used is not None else '?'}%"
                     f"   Media errors: {media}   Error-log entries: {elog}")
        samples.append(("drivecheck_nvme_available_spare_percent", base, spare))
        samples.append(("drivecheck_nvme_percentage_used", base, used))
        samples.append(("drivecheck_nvme_media_errors", base, media))
        samples.append(("drivecheck_nvme_error_log_entries", base, elog))
        samples.append(("drivecheck_ssd_percentage_used", base, used))
        samples.append(("drivecheck_nvme_critical_warning", base, cw))
        samples.append(("drivecheck_nvme_unsafe_shutdowns", base, h.get("unsafe_shutdowns")))
        samples.append(("drivecheck_nvme_power_cycles", base, h.get("power_cycles")))
        samples.append(("drivecheck_nvme_warning_temp_minutes", base, h.get("warning_temp_time")))
        samples.append(("drivecheck_nvme_critical_temp_minutes", base, h.get("critical_comp_time")))
        thr = {mm.group(1): int(mm.group(2)) for mm in re.finditer(r"Thermal Temp\. (\d) Transition Count:\s+(\d+)", text)}
        for lvl, n in sorted(thr.items()):
            samples.append(("drivecheck_nvme_thermal_throttle_events", dict(base, level=lvl), n))
        lines.append(f"Unsafe shutdowns: {h.get('unsafe_shutdowns')} of {h.get('power_cycles')} power cycles;"
                     f" minutes over warning/critical temperature: {h.get('warning_temp_time')}/"
                     f"{h.get('critical_comp_time')}" + (f"; throttle events: " + ", ".join(
                         f"level {k} {v}" for k, v in sorted(thr.items())) if thr else ""))
        if cw:
            alerts.append(f"DRIVE {serial} ({dev} on {host}): NVMe critical warning {cw:#x}")
            lines.append(f"ALERT: NVMe critical warning {cw:#x}")
        if spare is not None and spare < 70:
            alerts.append(f"DRIVE {serial} ({dev} on {host}): NVMe available spare {spare}%")
            lines.append(f"ALERT: available spare {spare}%")
        rising("media_errors", media, "NVMe media errors")
        state["unsafe_shutdowns"] = h.get("unsafe_shutdowns")
    return lines, samples, alerts, state, False


# ------------------------------------------------------------------ host level
def scan_devices():
    try:
        out = subprocess.run(["smartctl", "--scan"], capture_output=True, text=True, timeout=60).stdout
    except (OSError, subprocess.SubprocessError):
        out = ""
    devs = sorted({l.split()[0] for l in out.splitlines() if l.startswith("/dev/")})
    if not devs:
        devs = sorted(set(glob.glob("/dev/sd[a-z]") + glob.glob("/dev/sd[a-z][a-z]") + glob.glob("/dev/nvme[0-9]")))
    return devs


def network_lun(dev):
    name = os.path.basename(dev)
    if not name.startswith("sd"):
        return False
    try:
        if "/session" in os.path.realpath(f"/sys/block/{name}"):
            return True
        with open(f"/sys/block/{name}/device/vendor") as fh:
            return fh.read().strip() == "LIO-ORG"
    except OSError:
        return False


def json_network_lun(j):
    return ((j.get("scsi_vendor") or "").strip() == "LIO-ORG"
            or "iscsi" in str((j.get("scsi_transport_protocol") or {}).get("name", "")).lower())


def read_drive(dev):
    try:
        p = subprocess.run(["smartctl", "-x", "--json=o", "-n", "standby", dev], capture_output=True, text=True,
                           timeout=300)
    except subprocess.TimeoutExpired:
        return None, "smartctl timed out"
    except OSError as e:
        return None, f"smartctl failed: {e}"
    try:
        return json.loads(p.stdout), None
    except ValueError:
        return None, f"smartctl gave no JSON (exit {p.returncode})"


def kernel_io_errors():
    try:
        out = subprocess.run(["journalctl", "--since=-24h", "_TRANSPORT=kernel", "-o", "short-iso", "--no-pager",
                              "-q"], capture_output=True, text=True, timeout=120).stdout
    except (OSError, subprocess.SubprocessError):
        return None, []
    hits = [l for l in out.splitlines() if KERNEL_IO.search(l) and "audit" not in l.lower()]
    return len(hits), hits[-15:]


def load_state(path):
    try:
        with open(path) as fh:
            st = json.load(fh)
        return st if isinstance(st, dict) else {}
    except (OSError, ValueError):
        return {}


def write_atomic(path, data):
    d = os.path.dirname(path) or "."
    os.makedirs(d, exist_ok=True)
    tmp = f"{path}.tmp.{os.getpid()}"
    with open(tmp, "w") as fh:
        fh.write(data)
    os.replace(tmp, path)


def send_mail(host, email, log_dir, alerts, today):
    mailx = shutil.which("mailx")
    if not mailx or not (shutil.which("sendmail") or shutil.which("msmtp")):
        return "(no local mailer; the alert reaches Alertmanager through the textfile metrics)"
    body = (f"Hello Rohit,\n\nThe daily drive check on {host} found:\n\n" + "\n".join(alerts)
            + f"\n\nFull log: {log_dir}/drive_check_{today}.log\n")
    try:
        subprocess.run([mailx, "-s", f"[{host}] Drive Check Alert", email], input=body, text=True, timeout=120)
        return f"(emailed {email})"
    except (OSError, subprocess.SubprocessError) as e:
        return f"(email failed: {e})"


def main():
    ap = argparse.ArgumentParser(description="Daily SMART health check (see the docstring at the top of the file).")
    ap.add_argument("--fixtures", help="read DIR/smart-*.json instead of the drives (offline test)")
    ap.add_argument("--out", help="with --fixtures: write drivecheck.prom and state.json here, nothing else")
    ap.add_argument("--host", help="host label (default: hostname -s; with --fixtures: the fixture dir's name)")
    ap.add_argument("--version", action="version", version=f"drivecheck {VERSION}")
    a = ap.parse_args()

    fixtures = a.fixtures
    if fixtures and not a.out:
        ap.error("--fixtures needs --out")
    host = a.host or (os.path.basename(os.path.normpath(fixtures)) if fixtures
                      else socket.gethostname().split(".")[0])
    if os.environ.get("DRIVECHECK_LOG_DIR"):
        log_dir = os.environ["DRIVECHECK_LOG_DIR"]
    elif os.path.isdir("/pool/drive_logs"):
        log_dir = "/pool/drive_logs"
    else:
        log_dir = "/var/log/drive_logs"
    if fixtures:
        textfile_dir, state_path, no_mail = a.out, os.path.join(a.out, "state.json"), True
    else:
        textfile_dir = os.environ.get("DRIVECHECK_TEXTFILE_DIR") or (
            "/var/lib/node_exporter/textfile_collector" if os.path.isdir("/var/lib/node_exporter/textfile_collector")
            else "")
        state_path = os.environ.get("DRIVECHECK_STATE", "/var/lib/drivecheck/state.json")
        no_mail = os.environ.get("DRIVECHECK_NO_MAIL", "0") == "1"
        try:
            os.makedirs(log_dir, exist_ok=True)
        except OSError:
            pass
    email = os.environ.get("DRIVECHECK_EMAIL", "rohitnavani@gmail.com")
    pause = float(os.environ.get("DRIVECHECK_PAUSE", "1"))
    now = datetime.datetime.now().astimezone()
    today = now.strftime("%Y-%m-%d")

    print(f"\nDrive health check on {host} - {now.strftime('%a %b %d %I:%M:%S %p %Z %Y')} (drivecheck {VERSION})")
    state = load_state(state_path)
    metrics, alerts = Metrics(), []

    if fixtures:
        items = []
        for f in sorted(glob.glob(os.path.join(fixtures, "smart-*.json"))):
            try:
                with open(f) as fh:
                    j = json.load(fh)
            except (OSError, ValueError):
                print(f"\nWARNING: unreadable fixture {f}, skipping")
                continue
            items.append(((j.get("device") or {}).get("name") or f, j))
        source = iter(items)
    else:
        def live():
            first = True
            for dev in scan_devices():
                if network_lun(dev):
                    print(f"\n{dev}: network LUN (iSCSI), skipped")
                    continue
                if not first and pause > 0:
                    time.sleep(pause)
                first = False
                j, err = read_drive(dev)
                if j is None:
                    print(f"\nWARNING: {dev}: {err}, skipping")
                    continue
                yield dev, j
        source = live()

    for dev, j in source:
        if json_network_lun(j):
            print(f"\n{dev}: network LUN (iSCSI), skipped")
            continue
        serial = (j.get("serial_number") or "").strip()
        lines, samples, al, st, skipped = analyse(j, dev, host, state.get(serial), now.isoformat(timespec="seconds"))
        print("\n".join(lines))
        for name, labels, value in samples:
            metrics.add(name, labels, value)
        alerts.extend(al)
        if st is not None and serial:
            state[serial] = st

    if fixtures:
        print("\nKernel I/O errors (last 24 h): not read in fixture mode")
        kio = None
    else:
        kio, kl = kernel_io_errors()
        print("\nKernel I/O errors (last 24 h):")
        if kio is None:
            print("journal not readable")
        elif kio == 0:
            print("none")
        else:
            print("\n".join(kl))
            alerts.append(f"SYSTEM ({host}): {kio} kernel I/O error line(s) in the last 24 h, newest: {kl[-1][:200]}")
    if kio is not None:
        metrics.add("drivecheck_kernel_io_errors", {"host": host}, kio)

    metrics.add("drivecheck_alerts_total", {"host": host}, len(alerts))
    metrics.add("drivecheck_last_run_timestamp_seconds", {"host": host}, int(time.time()))
    if textfile_dir:
        try:
            write_atomic(os.path.join(textfile_dir, "drivecheck.prom"), metrics.render())
        except OSError as e:
            print(f"\nWARNING: could not write {textfile_dir}/drivecheck.prom: {e}")
    try:
        write_atomic(state_path, json.dumps(state, indent=1, sort_keys=True) + "\n")
    except OSError as e:
        print(f"\nWARNING: could not write state {state_path}: {e}")

    if alerts:
        print(f"\nALERTS present on {host}:")
        print("\n".join(alerts))
        print("(email skipped: DRIVECHECK_NO_MAIL=1)" if no_mail else send_mail(host, email, log_dir, alerts, today))
    else:
        print(f"\nNo alerts on {host}.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
