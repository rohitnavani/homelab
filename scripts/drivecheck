#!/bin/bash
# drivecheck - fleet drive health check for SATA, SAS and NVMe drives.
# Refactored 2026-10-06 from the original TinyNAS-only version:
#   - enumerates with `smartctl --scan` (handles SAS and more than 26 disks)
#   - separate parsing/alerting for ATA, SCSI/SAS and NVMe
#   - day-over-day persistence via explicit MARK lines keyed by serial
#   - writes a daily log, an optional node_exporter textfile metric, and emails on alert
#
# Env overrides:
#   DRIVECHECK_LOG_DIR       (default /var/log/drive_logs)
#   DRIVECHECK_TEXTFILE_DIR  (if set, writes <dir>/drivecheck.prom for node_exporter)
#   DRIVECHECK_EMAIL         (default rohitnavani@gmail.com)
#   DRIVECHECK_NO_MAIL=1     (skip email even if a mailer exists)
set -u

G="\033[0;32m"; R="\033[0;31m"; Y="\033[1;33m"; N="\033[0m"
# No color when output is not a terminal (keeps the daily log clean)
[ -t 1 ] || { G=""; R=""; Y=""; N=""; }
HOST=$(hostname -s 2>/dev/null || hostname)
# Log dir: env override, else /pool/drive_logs on TinyNAS, else /var/log/drive_logs
if [ -n "${DRIVECHECK_LOG_DIR:-}" ]; then LOG_DIR="$DRIVECHECK_LOG_DIR"
elif [ -d /pool/drive_logs ]; then LOG_DIR=/pool/drive_logs
else LOG_DIR=/var/log/drive_logs; fi
# Textfile dir: env override, else the node_exporter collector dir if present
TEXTFILE_DIR="${DRIVECHECK_TEXTFILE_DIR:-}"
[ -z "$TEXTFILE_DIR" ] && [ -d /var/lib/node_exporter/textfile_collector ] && TEXTFILE_DIR=/var/lib/node_exporter/textfile_collector
EMAIL="${DRIVECHECK_EMAIL:-rohitnavani@gmail.com}"
mkdir -p "$LOG_DIR" 2>/dev/null

_yesterday=$(date -d "yesterday" +%Y-%m-%d)
_prev_log="${LOG_DIR}/drive_check_${_yesterday}.log"
alert=""
prom=""
p(){ prom+="$1"$'\n'; }

# prev_mark SERIAL KEY  -> yesterday's numeric value for that drive's MARK line, else 0
prev_mark(){
    local s="$1" k="$2"
    [ -f "$_prev_log" ] || { echo 0; return; }
    awk -v s="$s" -v k="$k" '
        $0 ~ ("^===DRIVE=== ") { insec=0 }
        $0 ~ ("Serial: " s "(,| |$)") { insec=1 }
        insec && $0 ~ ("^MARK " k "=") { v=$0; sub(/^MARK [^=]+=/,"",v); gsub(/[^0-9]/,"",v); print v+0; exit }
    ' "$_prev_log" 2>/dev/null | head -1
}

emit_common(){ # dev class model serial health_ok temp poh
    local dev="$1" cls="$2" model="$3" serial="$4" hok="$5" temp="$6" poh="$7"
    local lbl="host=\"$HOST\",device=\"$dev\",serial=\"$serial\",class=\"$cls\",model=\"$model\""
    p "drivecheck_health_ok{$lbl} $hok"
    [ -n "$temp" ] && p "drivecheck_temperature_celsius{$lbl} $temp"
    [ -n "$poh" ]  && p "drivecheck_power_on_hours{$lbl} $poh"
}

echo
echo -e "${Y}Drive health check on ${HOST} - $(date)${N}"

# ---- enumerate real SMART devices (robust for SAS / >26 disks) ----
mapfile -t DEVS < <(sudo smartctl --scan 2>/dev/null | awk '{print $1}' | sort -u)
# fallback if scan yields nothing
if [ "${#DEVS[@]}" -eq 0 ]; then
    for d in /dev/sd?[a-z] /dev/sd? /dev/nvme?n?; do [ -e "$d" ] && DEVS+=("$d"); done
fi

for d in "${DEVS[@]}"; do
    [ -e "$d" ] || continue
    out=$(sudo smartctl -a "$d" 2>/dev/null)
    [ -z "$out" ] && continue

    # classify
    if echo "$d" | grep -q nvme || grep -q "NVMe Version\|Number of Namespaces\|Namespace 1" <<<"$out"; then
        cls=nvme
    elif grep -q "Transport protocol:.*SAS" <<<"$out" || grep -q "SMART Health Status:" <<<"$out"; then
        cls=sas
    else
        cls=sata
    fi

    model=$(awk -F: '/^(Device Model|Model Number|Product)/{gsub(/^[ \t]+/,"",$2);print $2;exit}' <<<"$out")
    [ "$cls" = sas ] && { vend=$(awk -F: '/^Vendor:/{gsub(/^[ \t]+/,"",$2);print $2;exit}' <<<"$out"); model="${vend:+$vend }$model"; }
    serial=$(awk -F: '/^(Serial Number|Serial number)/{gsub(/^[ \t]+/,"",$2);print $2;exit}' <<<"$out")
    cap=$(awk -F: '/(User Capacity|Total NVM Capacity|Namespace 1 Size)/{gsub(/^[ \t]+/,"",$2);print $2;exit}' <<<"$out" | grep -oP '\[\K[^\]]+' | head -1)
    [ -z "$serial" ] && { echo -e "${R}WARNING: no serial for $d, skipping${N}"; continue; }

    echo; echo "===DRIVE=== $d ($cls)"
    echo -e "${Y}Model: ${model:-?}, Serial: $serial, Capacity: ${cap:-?}${N}"

    # health
    status=$(awk '/SMART overall-health|SMART Health Status/{print $NF}' <<<"$out"); status=${status:-UNKNOWN}
    if [[ "$status" == PASSED || "$status" == OK ]]; then hok=1; echo -e "${G}Health: $status${N}"
    else hok=0; echo -e "${R}Health: $status${N}"; alert+="DRIVE $serial ($d on $HOST): health $status\n"; fi

    temp=$(awk -F: '/Current Drive Temperature|Temperature:/{v=$2; gsub(/[^0-9]/,"",v); if(v!=""){print v; exit}}' <<<"$out")
    # SATA drives report temperature as attribute 194/190 rather than a Temperature: line
    [ -z "$temp" ] && temp=$(awk '/ID# ATTRIBUTE_NAME/{h=1;next} h&&($1==194||$1==190){print $10; exit}' <<<"$out" | grep -oE '^[0-9]+' | head -1)
    poh=$(awk '/Power_On_Hours/{print $NF} /Accumulated power on time/{split($NF,a,":"); print a[1]} /Power On Hours/{print $NF}' <<<"$out" | tr -d ',' | head -1)
    [ -n "$temp" ] && echo "Temperature: ${temp} C"
    [ -n "$poh" ]  && echo "Power_On_Hours: ${poh}"
    emit_common "$d" "$cls" "${model:-?}" "$serial" "$hok" "$temp" "$poh"

    # self-test (ATA and SAS share the "# 1 ..." line; NVMe usually none)
    stline=$(awk '/^# *1 /{print; exit}' <<<"$out")
    if [ -n "$stline" ]; then
        if grep -qi "fail" <<<"$stline"; then st=0; echo -e "${R}Last self-test FAILED: $stline${N}"; alert+="DRIVE $serial ($d on $HOST): last self-test FAILED\n"
        elif grep -qi "interrupt" <<<"$stline"; then st=0; echo -e "${R}Last self-test interrupted: $stline${N}"; alert+="DRIVE $serial ($d on $HOST): last self-test interrupted\n"
        elif grep -qi "Completed" <<<"$stline"; then st=1; echo -e "${G}Last self-test passed${N}"
        else st=1; echo -e "${Y}Last self-test: $stline${N}"; fi
        p "drivecheck_selftest_passed{host=\"$HOST\",device=\"$d\",serial=\"$serial\"} $st"
    elif [ "$cls" != nvme ]; then
        echo -e "${Y}No self-test logged yet${N}"
    fi

    case "$cls" in
    sata)
        # critical ATA attributes: raw value + alert on increase vs yesterday
        declare -A A=( [5]=Reallocated_Sector_Ct [196]=Reallocated_Event_Count [197]=Current_Pending_Sector [198]=Offline_Uncorrectable [199]=UDMA_CRC_Error_Count )
        for id in "${!A[@]}"; do
            name="${A[$id]}"
            cur=$(awk -v id="$id" '/ID# ATTRIBUTE_NAME/{h=1;next} h&&$1==id{v=$NF;gsub(/[^0-9]/,"",v);print v;exit}' <<<"$out"); cur=${cur:-0}
            key="attr_${id}"
            echo "MARK ${key}=${cur}    # ${name}"
            p "drivecheck_ata_attr_raw{host=\"$HOST\",device=\"$d\",serial=\"$serial\",id=\"$id\",name=\"$name\"} $cur"
            prev=$(prev_mark "$serial" "$key"); prev=${prev:-0}
            if [ "$cur" -gt "$prev" ]; then
                echo -e "${R}ALERT: $name ($id) ${prev} -> ${cur}${N}"
                alert+="DRIVE $serial ($d on $HOST): $name rose ${prev} -> ${cur}\n"
            fi
        done
        echo "$out" | awk '/ID# ATTRIBUTE_NAME/{h=1;print;next} h&&($1==5||$1==187||$1==188||$1==197||$1==198||$1==199){print} h&&/^$/{exit}'
        ;;
    sas)
        gdl=$(awk -F: '/Elements in grown defect list/{v=$2;gsub(/[^0-9]/,"",v);print v;exit}' <<<"$out"); gdl=${gdl:-0}
        # total uncorrected errors = sum of last column of read/write/verify rows
        unc=$(awk '/^(read|write|verify):/{s+=$NF} END{print s+0}' <<<"$out")
        nme=$(awk -F: '/Non-medium error count/{v=$2;gsub(/[^0-9]/,"",v);print v;exit}' <<<"$out"); nme=${nme:-0}
        echo "MARK grown_defects=${gdl}"
        echo "MARK uncorrected=${unc}"
        echo -e "Grown defect list: ${gdl}    Uncorrected errors: ${unc}    Non-medium errors: ${nme}"
        local_lbl="host=\"$HOST\",device=\"$d\",serial=\"$serial\""
        p "drivecheck_sas_grown_defects{$local_lbl} $gdl"
        p "drivecheck_sas_uncorrected_errors{$local_lbl} $unc"
        p "drivecheck_sas_nonmedium_errors{$local_lbl} $nme"
        prevg=$(prev_mark "$serial" grown_defects); prevg=${prevg:-0}
        [ "$gdl" -gt "$prevg" ] && { echo -e "${R}ALERT: grown defect list ${prevg} -> ${gdl}${N}"; alert+="DRIVE $serial ($d on $HOST): grown defects ${prevg} -> ${gdl}\n"; }
        [ "$unc" -gt 0 ]        && { echo -e "${R}ALERT: ${unc} uncorrected errors${N}"; alert+="DRIVE $serial ($d on $HOST): ${unc} uncorrected errors\n"; }
        ;;
    nvme)
        spare=$(awk -F: '/Available Spare:/{v=$2;gsub(/[^0-9]/,"",v);print v;exit}' <<<"$out")
        used=$(awk -F: '/Percentage Used:/{v=$2;gsub(/[^0-9]/,"",v);print v;exit}' <<<"$out")
        media=$(awk -F: '/Media and Data Integrity Errors:/{v=$2;gsub(/[^0-9]/,"",v);print v;exit}' <<<"$out"); media=${media:-0}
        elog=$(awk -F: '/Error Information Log Entries:/{v=$2;gsub(/[^0-9]/,"",v);print v;exit}' <<<"$out"); elog=${elog:-0}
        echo "MARK available_spare=${spare:-100}"
        echo "MARK media_errors=${media}"
        echo -e "Available spare: ${spare:-?}%   Used: ${used:-?}%   Media errors: ${media}   Error-log entries: ${elog}"
        local_lbl="host=\"$HOST\",device=\"$d\",serial=\"$serial\""
        [ -n "$spare" ] && p "drivecheck_nvme_available_spare_percent{$local_lbl} $spare"
        [ -n "$used" ]  && p "drivecheck_nvme_percentage_used{$local_lbl} $used"
        p "drivecheck_nvme_media_errors{$local_lbl} $media"
        p "drivecheck_nvme_error_log_entries{$local_lbl} $elog"
        [ -n "$spare" ] && [ "$spare" -lt 70 ] && { echo -e "${R}ALERT: available spare ${spare}%${N}"; alert+="DRIVE $serial ($d on $HOST): NVMe available spare ${spare}%\n"; }
        [ "$media" -gt 0 ] && { echo -e "${R}ALERT: ${media} media/data-integrity errors${N}"; alert+="DRIVE $serial ($d on $HOST): ${media} NVMe media errors\n"; }
        ;;
    esac
done

# ---- kernel I/O errors ----
echo; echo -e "${Y}Kernel I/O errors:${N}"
io=$(journalctl -k 2>/dev/null | grep -iE "i/o error|blk_update_request|buffer i/o" | grep -v audit | tail -n 15)
if [ -z "$io" ]; then echo -e "${G}none${N}"; else echo -e "${R}$io${N}"; alert+="SYSTEM ($HOST): kernel I/O errors:\n$io\n"; fi

# ---- prometheus textfile output ----
if [ -n "$TEXTFILE_DIR" ]; then
    mkdir -p "$TEXTFILE_DIR" 2>/dev/null
    nalert=$(printf "%b" "$alert" | grep -c . 2>/dev/null); nalert=${nalert:-0}
    {
        echo "# HELP drivecheck_alerts_total Number of drive alerts at last run."
        echo "drivecheck_alerts_total{host=\"$HOST\"} $nalert"
        echo "drivecheck_last_run_timestamp_seconds{host=\"$HOST\"} $(date +%s)"
        printf "%s" "$prom"
    } > "${TEXTFILE_DIR}/drivecheck.prom.$$" 2>/dev/null && mv "${TEXTFILE_DIR}/drivecheck.prom.$$" "${TEXTFILE_DIR}/drivecheck.prom" 2>/dev/null
fi

# ---- email on alert (only if a mailer is present) ----
if [ -n "$alert" ]; then
    echo; echo -e "${R}ALERTS present on ${HOST}.${N}"
    if [ "${DRIVECHECK_NO_MAIL:-0}" != 1 ] && command -v mailx >/dev/null 2>&1 && { command -v sendmail >/dev/null 2>&1 || command -v msmtp >/dev/null 2>&1; }; then
        printf "Hello Rohit,\n\nThe daily drive check on %s found:\n\n%b\nFull log: %s/drive_check_%s.log\n" \
            "$HOST" "$alert" "$LOG_DIR" "$(date +%Y-%m-%d)" | mailx -s "[$HOST] Drive Check Alert" "$EMAIL"
        echo "(emailed $EMAIL)"
    else
        echo "(no local mailer; alert is exposed via the node_exporter textfile for central Alertmanager)"
    fi
fi
