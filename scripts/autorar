sudo bash -c 'read -p "Enter SOURCE file or directory path (e.g., /path/to/my_folder): " SOURCE_PATH_RAW; read -p "Enter DESTINATION directory path (e.g., /path/to/backups/): " DEST_DIR_RAW; SOURCE_PATH="$(echo "$SOURCE_PATH_RAW" | sed -e "s/^[[:space:]]*//" -e "s/[[:space:]]*$//")"; DEST_DIR="$(echo "$DEST_DIR_RAW" | sed -e "s/^[[:space:]]*//" -e "s/[[:space:]]*$//")"; if [ -z "$SOURCE_PATH" ] || [ -z "$DEST_DIR" ]; then echo "Error: Source or destination path cannot be empty. Exiting."; exit 1; fi; PARENT_DIR=$(dirname "$SOURCE_PATH"); ITEM_NAME=$(basename "$SOURCE_PATH"); RAR_COMPRESSION_ARGS="-m5 -s -md512m -ma5"; mkdir -p "$DEST_DIR" && cd "$PARENT_DIR" && rar a $RAR_COMPRESSION_ARGS "$DEST_DIR/$ITEM_NAME.rar" "$ITEM_NAME" && echo "Successfully created \"$ITEM_NAME.rar\" in \"$DEST_DIR\"." && rm -rf $SOURCE_PATH || echo "Failed to create RAR archive for \"$ITEM_NAME\"." '
