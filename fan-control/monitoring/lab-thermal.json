  {
   "id": 11,
   "type": "timeseries",
   "title": "Fan controller health",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 20
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "lab_controller_state_age_seconds",
     "legendFormat": "{{controller}} state age"
    },
    {
     "refId": "B",
     "expr": "lab_md1200_takeovers",
     "legendFormat": "shelf takeovers (right)"
    }
   ],
   "fieldConfig": {
