{
 "uid": "lab-thermal",
 "title": "Lab - Thermal",
 "tags": [
  "lab"
 ],
 "schemaVersion": 39,
 "version": 2,
 "editable": true,
 "time": {
  "from": "now-12h",
  "to": "now"
 },
 "refresh": "30s",
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Room (mementos inlet)",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "lab_r720_temp_celsius{sensor=\"inlet\"}",
     "legendFormat": "inlet"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 27
       },
       {
        "color": "orange",
        "value": 29
       },
       {
        "color": "red",
        "value": 31
       }
      ]
     }
    },
    "overrides": []
   },
   "description": "iDRAC inlet sensor, 1C steps; reads a few degrees above the room air. Pre-10-04 with the AC working: 23-25C."
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Shelf hottest drive",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "lab_md1200_temp_celsius{sensor=\"drive\"}",
     "legendFormat": "drive"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 50
       },
       {
        "color": "orange",
        "value": 52
       },
       {
        "color": "red",
        "value": 56
       }
      ]
     }
    },
    "overrides": []
   },
   "description": "md1200-fan target 48.5C (smoothed); urgent at 52; drive trip 60."
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Shelf fans",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "lab_md1200_fan_percent",
     "legendFormat": "shelf %"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 25
       },
       {
        "color": "red",
        "value": 45
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "R720 fans",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "lab_r720_fan_percent",
     "legendFormat": "R720 %"
    },
    {
     "refId": "B",
     "expr": "lab_r720_fan_auto * 100",
     "legendFormat": "auto"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 25
       },
       {
        "color": "red",
        "value": 40
       }
      ]
     }
    },
    "overrides": []
   },
   "description": "fan-watchdog; 'auto' = 100 when it handed the fans to iDRAC auto (loud)."
  },
  {
   "id": 5,
   "type": "stat",
   "title": "ryuji fan offset",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 16,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "lab_ryuji_fan_offset",
     "legendFormat": "offset"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": -16
       },
       {
        "color": "red",
        "value": 0
       }
      ]
     }
    },
    "overrides": []
   },
   "description": "ryuji-fan-guard: -80 quiet, -16 warm, 0 Performance, 127 Full."
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Rack current",
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "cyberpower_pdu_bank_load_deciamps{bank=\"1\"} / 10",
     "legendFormat": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "amp",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 12
       },
       {
        "color": "red",
        "value": 16
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Room proxies",
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "lab_r720_temp_celsius{sensor=\"inlet\"}",
     "legendFormat": "mementos inlet (iDRAC)"
    },
    {
     "refId": "B",
     "expr": "node_ipmi_temperature_celsius{sensor=\"MB_TEMP1\"} * on(instance) group_left(nodename) node_uname_info{nodename=\"sojiro\"}",
     "legendFormat": "sojiro MB_TEMP1"
    },
    {
     "refId": "C",
     "expr": "node_ipmi_temperature_celsius{sensor=\"MB Temp\"} * on(instance) group_left(nodename) node_uname_info{nodename=\"makoto\"}",
     "legendFormat": "makoto MB"
    },
    {
     "refId": "D",
     "expr": "node_hwmon_temp_celsius{chip=\"nvme_nvme0\",sensor=\"temp1\"} * on(instance) group_left(nodename) node_uname_info{nodename=\"TinyNAS\"}",
     "legendFormat": "tinynas nvme0"
    },
    {
     "refId": "E",
     "expr": "node_hwmon_temp_celsius{chip=\"platform_nct6775_656\",sensor=\"temp1\"} * on(instance) group_left(nodename) node_uname_info{nodename=\"TinyNAS\"}",
     "legendFormat": "tinynas SYSTIN"
    },
    {
     "refId": "F",
     "expr": "cyberpower_pdu_bank_load_deciamps{bank=\"1\"} / 10",
     "legendFormat": "rack A (right)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "decimals": 1,
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": 120000
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "rack A.*"
      },
      "properties": [
       {
        "id": "custom.axisPlacement",
        "value": "right"
       },
       {
        "id": "unit",
        "value": "amp"
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          6,
          4
         ]
        }
       },
       {
        "id": "min",
        "value": 0
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "description": "Independent room-tracking sensors on four machines (the AC's hourly cycle shows in all of them) and the rack current."
  },
