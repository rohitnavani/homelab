#!/usr/bin/env python3
# md1200-fan: keep the MD1200 shelf quiet via its EMM serial console (_shutup <pct>).
# Picks a fan % from the hottest shelf drive and the EMM backplane/SIM/expander sensors
# every 30s, on a stepped curve: 10% at idle, +5% per couple of degrees above that.
# The shelf drops back to its ~5000 rpm default about 10s after each _shutup, so the
# chosen % is re-sent every few seconds to hold it.
# Measured 2026-10-05: 10% ~2330, 15% ~2800, 20% ~3290, 25% ~3770, 30% ~4250 rpm.
import re, subprocess, sys, time, serial

PORT = '/dev/ttyUSB0'
INTERVAL = 30   # temp check
RESEND = 2      # seconds between _shutup re-sends (EMMs drop the setting ~10s after a
                # command in some states, and a watchdog restarts them every ~324s)
# Curves per sensor: (quiet limit, degrees per 5% step, (temp, %) floors near the limits).
# 10% while at or under the quiet limit, then +5% for every started step above it.
# Drives idle at about 43-45C at 10%; ST8000NM0075 is rated to 60C.
# SES warns at backplane 50C and SIM 65C; the firmware itself ramps near backplane 44C.
CURVES = {
    'drive':     (47, 2, [(58, 80)]),
    'backplane': (43, 2, [(48, 50), (50, 80)]),
    'SIM':       (55, 3, [(62, 50), (65, 80)]),
    'expander':  (85, 3, [(95, 80)]),
}
MIN, MAX = 10, 80
FALLBACK = 30   # if temps can't be read for STALE seconds
STALE = 60      # a failed read keeps the current speed until reads have failed this long
RETRY = 5       # seconds before re-reading after a failed read
HYST = 2        # step down only once temps are this far under the current step's threshold
HOLD = 120      # and at least this many seconds after the last change

def emm(cmd):
    with serial.Serial(PORT, 38400, timeout=0.5) as s:
        s.reset_input_buffer()
        s.write((cmd + '\r').encode())
        out, end = b'', time.time() + (2 if cmd == '_temp_rd' else 0.4)
        while time.time() < end:
            d = s.read(4096)
            if d:
                out += d
                end = max(end, time.time() + 0.5)
    return out.decode(errors='replace')

def shelf_disks():
    # dataPool's data vdevs live on the MD1200 shelf; its log SSD (and any cache/special
    # vdevs) sit in the R720xd, so stop at the first section header (logs, cache, ...)
    out = subprocess.run(['zpool', 'list', '-vHP', 'dataPool'], capture_output=True, text=True).stdout
    devs = []
    for line in out.splitlines()[1:]:
        if line and not line[0].isspace():
            break
        devs += re.findall(r'(/dev/\S+)', line)
    return sorted({re.sub(r'-part\d+$', '', d) for d in devs})

def drive_temp(dev):
    out = subprocess.run(['smartctl', '-n', 'standby', '-A', dev], capture_output=True, text=True).stdout
    m = re.search(r'Current Drive Temperature:\s+(\d+)', out) or re.search(r'^194 .*?(\d+)(?: \(.*\))?$', out, re.M)
    return int(m.group(1)) if m else None

def read_temps():
    drives = [t for t in map(drive_temp, shelf_disks()) if t]
    out = emm('_temp_rd')
    bp = [int(x) for x in re.findall(r'BP_\d\[\d\] = (\d+)c', out)]
    sim = [int(x) for x in re.findall(r'SIM\d\[\d\] = (\d+)c', out)]
    exp = [int(x) for x in re.findall(r'EXP\d\[\d\] = (\d+)c', out)]
    if not (drives and bp and sim and exp):
        return None
    return {'drive': max(drives), 'backplane': max(bp), 'SIM': max(sim), 'expander': max(exp)}

def level(temps, offset=0):
    # fan % the temps ask for; offset > 0 reads every sensor that many degrees warmer
    pct = MIN
    for name, (quiet, step, floors) in CURVES.items():
        t = temps[name] + offset
        p = MIN if t <= quiet else MIN + 5 * -(-(t - quiet) // step)
        for ft, fp in floors:
            if t >= ft:
                p = max(p, fp)
        pct = max(pct, p)
    return min(pct, MAX)

def fmt(temps):
    return ' '.join(f'{k}={v}' for k, v in temps.items())

pct, changed, checked, last_good = None, 0, 0, time.time()
print('starting', flush=True)
while True:
    try:
        if time.time() - checked >= INTERVAL:
            temps = read_temps()
            checked = time.time()
            new = pct
            if temps is None:
                checked -= INTERVAL - RETRY          # re-read soon
                if pct is None or time.time() - last_good >= STALE:
                    new = FALLBACK                   # brief glitch: keep the current speed
            else:
                last_good = time.time()
                want = level(temps)
                if pct is None or want > pct:
                    new = want                       # start, or step up right away
                elif want < pct and time.time() - changed >= HOLD:
                    # one step down, only if still lower with HYST degrees of margin
                    new = max(level(temps, HYST), pct - 5)
            if new != pct:
                print(f'fan {new}% ({fmt(temps) if temps else "temps unreadable"})', flush=True)
                pct, changed = new, time.time()
        emm('_shutup %d' % pct)
    except Exception as ex:
        print('error:', ex, file=sys.stderr, flush=True)
        time.sleep(10)
    time.sleep(RESEND)
