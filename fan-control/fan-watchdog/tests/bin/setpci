#!/bin/bash
read cpu exh inlet hdd ssd fail dimm dimmfail < ${WD_DIR}/scen
dev=$2; reg=${3%.L}
if [ "$dev" = 0000:3f:10.0 ]; then echo 07000000; exit 0; fi      # unused channel
case $reg in 0x158) echo 05000055; exit 0;; esac                  # empty slot
[ "$dimmfail" = 1 ] && exit 1
if [ $reg = 0x150 ]; then printf '07%06x\n' $dimm; else printf '07%06x\n' $((dimm-2)); fi
