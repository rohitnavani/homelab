# deploy.list - how each host runs each script in this repo. `lab-scripts status` checks every entry; `lab-scripts link
# HOST` and `lab-scripts install NAME HOST` put them in place. private/deploy.list (not public) does the same for the
# private scripts.
#
#   SOURCE                                      PATH ON THE HOST                      HOSTS ...  [check-only]
#
# [links]  The host's path is a symlink to this repo at /dataPool/homelab, so every host runs the one copy and an edit
#          is live everywhere.
# [copies] A real file on the host, for what must never wait on the share: the fan controllers and fan scripts (with
#          fan-control/monitoring's thermal-log and lab-thermal-textfile, services that start at boot), the battery
#          guards, mementos's check of the pool the share lives on, everything on sojiro (the backup box: nothing
#          on the rest of the lab may change what it runs as root), akechi's monitoring (a laptop, often away), and
#          cron schedules (cron rereads them every minute and would stall on a stalled share). check-only: compared,
#          never copied by lab-scripts; a fan controller goes in with a restart and a live check (fan-control/README.md).
# HOST:PATH means that host keeps it at another path.

[links]
scripts/drivecheck                              /usr/local/bin/drivecheck             futaba makoto mementos morgana ryuji tinynas tinypc yusuke
scripts/drive-selftest                          /usr/local/bin/drive-selftest         futaba makoto mementos morgana ryuji tinynas tinypc yusuke
scripts/zfs_metrics                             /usr/local/bin/zfs_metrics            makoto ryuji tinynas
scripts/zfs-snapshot                            /usr/local/sbin/zfs-snapshot          makoto mementos ryuji
scripts/zfs-retention                           /usr/local/sbin/zfs-retention         makoto mementos ryuji
scripts/snapshot                                /usr/local/bin/snapshot               tinynas
scripts/retention                               /usr/local/bin/retention              tinynas
scripts/root_disk_metrics                       /usr/local/bin/root_disk_metrics      tinynas
scripts/backup-mementos                         /usr/local/sbin/backup-mementos       tinynas
scripts/prune-replica                           /usr/local/sbin/prune-replica         tinynas
scripts/autorar                                 /usr/local/bin/autorar                tinynas
scripts/futaba-backup                           /usr/local/bin/futaba-backup          futaba
scripts/resume-uptime                           /usr/local/bin/resume-uptime          futaba

[copies]
