# Immich on mementos. See docker-compose.yml. Keep IMMICH_VERSION equal to tinynas immich-ml/.env.
UPLOAD_LOCATION=/dataPool/immich/library
DB_DATA_LOCATION=/dataPool/immich/postgres
TZ=America/New_York
IMMICH_VERSION=v3.4.1
# DB_PASSWORD: 32 random A-Za-z0-9, e.g. $(openssl rand -base64 64 | tr -dc A-Za-z0-9 | cut -c1-32)
DB_PASSWORD=
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
